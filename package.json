{
  "name": "nayori-agent-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server that lets an AI agent act on the live Nayori contracts on Stacks mainnet with its own wallet: register, find jobs, apply, accept, deliver committed evidence, request evaluation. Built on @perkos/agent-sdk.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nayori-agent-mcp": "server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "call": "node call.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@perkos/agent-sdk": "0.10.0",
    "@stacks/transactions": "7.6.0",
    "zod": "3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PerkOS-xyz/Nayori-Agent-MCP.git"
  },
  "license": "MIT",
  "homepage": "https://docs.nayori.ai"
}
